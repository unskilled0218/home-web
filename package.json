{
  "name": "dashboard",
  "version": "0.14.1",
  "private": true,
  "description": "A self-hosted dashboard for CalDAV events, Home Assistant devices, Linkwarden bookmarks, and Wake-on-LAN controls.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:lan": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/*.js && node --check public/*.js"
  }
}
