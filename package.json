{
  "name": "dashboard",
  "version": "0.17.3",
  "private": true,
  "description": "A self-hosted photo dashboard with a clock, weather forecasts, and CalDAV events.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:lan": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:browser": "playwright test --browser=chromium",
    "check": "node --check src/*.js && node --check public/*.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
