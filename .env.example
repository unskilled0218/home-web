# Bind to a specific private LAN address in production, for example 192.168.1.10.
HOST=127.0.0.1
PORT=3000
# Compose image override for pinning or rollback; omit to use git.lan/dev/home-web:latest.
HOME_WEB_IMAGE=git.lan/dev/home-web:latest
# Comma-separated private DNS or reverse-proxy hostnames used to access the dashboard.
DASHBOARD_ALLOWED_HOSTS=
DATABASE_PATH=./data/wol.db
WOL_PORT=9
WAKE_COOLDOWN_SECONDS=20
# Optional integration-credential key override: base64-encoded 32 bytes, e.g. `openssl rand -base64 32`.
# An explicit secret takes precedence over the persistent key file below.
LINKWARDEN_CONFIG_ENCRYPTION_KEY=
# The server creates this shared integration-credential key file when no explicit key is set.
LINKWARDEN_CONFIG_ENCRYPTION_KEY_FILE=./data/linkwarden-config-encryption.key
LINKWARDEN_CACHE_SECONDS=60
# Optional private CA bundle used only for Linkwarden HTTPS requests.
# Files under ./certs are mounted read-only at /app/certs in the supplied Compose service.
LINKWARDEN_CA_FILE=
HOME_ASSISTANT_CACHE_SECONDS=30
# Optional private CA path used by Compose, for example ./certs/home-assistant-ca.pem.
HOME_ASSISTANT_CA_FILE=
# Direct Node runs must use Node's native process-wide variable instead.
# NODE_EXTRA_CA_CERTS=./certs/home-assistant-ca.pem
CALDAV_CACHE_SECONDS=300
# Optional private CA bundle used only for CalDAV HTTPS requests.
CALDAV_CA_FILE=
# Optional dashboard backgrounds. Compose reads a host-mounted directory when mode is `existing`.
NFS_MOUNT_MODE=disabled
# Host path mounted read-only at /photos by Compose. It may itself be an NFS mount.
NFS_HOST_MOUNT_PATH=./photos
# Direct Node runs can mount NFS during startup with the settings below; Compose does not pass them through.
NFS_SOURCE=
NFS_MOUNT_PATH=
# Optional comma-separated settings such as vers=4.2. Bounded read-only safety settings are always applied.
NFS_MOUNT_OPTIONS=
