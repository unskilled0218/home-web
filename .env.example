# Bind to a specific private LAN address in production, for example 192.168.1.10.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/wol.db
WOL_PORT=9
WAKE_COOLDOWN_SECONDS=20
# Optional explicit override: base64-encoded 32-byte key, e.g. `openssl rand -base64 32`.
# Compose creates and reuses data/linkwarden-config-encryption.key when this is empty.
LINKWARDEN_CONFIG_ENCRYPTION_KEY=
# Optional for direct runs. The server creates this file when no explicit key is set.
LINKWARDEN_CONFIG_ENCRYPTION_KEY_FILE=
LINKWARDEN_CACHE_SECONDS=60
